{
  "name": "@drimworks/convex-topics",
  "description": "Hierarchical, searchable topic trees as a Convex component. Workspace-scoped, auth-agnostic.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "src"],
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "codegen": "convex codegen --component-dir ./src/component",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "convex": ">=1.31.0"
  },
  "devDependencies": {
    "convex": "^1.31.2",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3"
  }
}
